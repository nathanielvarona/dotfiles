-- =========================================================
-- PowerShell as Neovim Shell on Windows
-- =========================================================
-- Prefer PowerShell 7 (`pwsh.exe`) and fall back to the Windows PowerShell 5.1
-- that ships with Windows when 7 is not installed. Using PowerShell instead of
-- cmd.exe gives better scripting, UTF-8 handling, and consistency with modern
-- Windows terminal environments.

if vim.fn.has("win32") == 1 then
  -- Do not use `LazyVim.terminal.setup()` here: it re-checks pwsh with
  -- `vim.fn.executable()`, which cannot see Windows App Execution Aliases (the
  -- packaged pwsh that winget installs), so it silently falls back to 5.1.
  -- `where.exe` sees the alias, and the list form bypasses `&shell`, so this
  -- detection also works while options are loading.
  local where = vim.fn.system({ "where.exe", "pwsh.exe" })
  local has_pwsh = vim.v.shell_error == 0 and where:lower():find("pwsh.exe", 1, true) ~= nil

  vim.o.shellquote = ""
  vim.o.shellxquote = ""

  -- Neovim cannot spawn the pwsh App Execution Alias directly (E475), so use
  -- the managed cmd shim, which jobstart, :terminal, and :! can all execute.
  local shim = vim.fn.expand("~/.local/bin/pwsh-term.cmd")

  if has_pwsh and vim.fn.executable(shim) == 1 then
    vim.o.shell = shim
    vim.o.shellcmdflag = "-NoProfile -NoLogo -NonInteractive -ExecutionPolicy RemoteSigned -Command [Console]::InputEncoding=[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new();$PSDefaultParameterValues['Out-File:Encoding']='utf8';$PSStyle.OutputRendering='plaintext';Remove-Alias -Force -ErrorAction SilentlyContinue tee;"
    vim.o.shellredir = '2>&1 | %%{ "$_" } | Out-File %s; exit $LastExitCode'
    vim.o.shellpipe = '2>&1 | %%{ "$_" } | tee %s; exit $LastExitCode'
  else
    -- Windows PowerShell 5.1 rejects the PowerShell 7-only flags
    -- (`$PSStyle`, `Remove-Alias`), so keep the 5.1-safe set.
    vim.o.shell = "powershell"
    vim.o.shellcmdflag = "-NoLogo -NoProfile -ExecutionPolicy RemoteSigned -Command"
    vim.o.shellredir = "2>&1 | Out-File -Encoding utf8 %s; exit $LASTEXITCODE"
    vim.o.shellpipe = "2>&1 | Tee-Object %s; exit $LASTEXITCODE"
  end
end

-- Integrate Sysmtem Clipboard
{{- if eq .chezmoi.os "linux" -}}
{{- if .chezmoi.kernel.osrelease | contains "WSL2" }}
vim.g.clipboard = {
  name = 'win32yank-wsl',
  copy = {
    ['+'] = 'win32yank.exe -i --crlf',
    ['*'] = 'win32yank.exe -i --crlf',
  },
  paste = {
    ['+'] = 'win32yank.exe -o --lf',
    ['*'] = 'win32yank.exe -o --lf',
  },
  cache_enabled = 0,
}

vim.opt.clipboard = "unnamedplus" -- syncs Neovim's clipboard with the system clipboard
{{- end }}
{{- end -}}

-- Try to recognize unix (LF) formats first, then dos (CRLF)
vim.opt.fileformats = "unix,dos"

-- Default fallback format for entirely new files
vim.opt.fileformat = "unix"
