{{- /*

  PowerShell Version 5 and 7+ Compatible Profile

*/ -}}

# ============================================================
# PowerShell Profile (Managed by chezmoi)
# Cross-platform: macOS / Linux / Windows
# Zero runtime OS branching
# ============================================================

# ------------------------------------------------------------
# XDG Base Directory
# ------------------------------------------------------------

$env:XDG_CONFIG_HOME = "$HOME/.config"
$env:XDG_CACHE_HOME  = "$HOME/.cache"

# ------------------------------------------------------------
# User Secrets
# ------------------------------------------------------------

$SecretsFile = Join-Path $HOME ".secrets.ps1"

if (Test-Path $SecretsFile)
{
    . $SecretsFile
}

# ------------------------------------------------------------
# Cursor Shape (PowerShell 7+ only)
# ------------------------------------------------------------

if ($PSVersionTable.PSVersion.Major -ge 7)
{
  Write-Host -NoNewLine "`e[6 q"
}


# ------------------------------------------------------------
# Disable mise Warning (PowerShell <7 only)
# ------------------------------------------------------------
if ($PSVersionTable.PSVersion.Major -lt 7) {
    $env:MISE_PWSH_CHPWD_WARNING = 0
}

# ------------------------------------------------------------
# Oh My Posh Prompt (Custom + Built-in Themes)
# ------------------------------------------------------------

# Default theme
if (-not $env:POSH_THEME) {
  $env:POSH_THEME = "zen"
}

# Custom theme path (XDG)
$customTheme = Join-Path $env:XDG_CONFIG_HOME "oh-my-posh/$env:POSH_THEME.omp.toml"

# Resolve config:
# - If custom file exists → use path
# - Else → assume built-in theme name
if (Test-Path $customTheme) {
  $poshConfig = $customTheme
} else {
  $poshConfig = $env:POSH_THEME
}

# Initialize Oh My Posh
if (Get-Command oh-my-posh -ErrorAction SilentlyContinue) {
  oh-my-posh init pwsh --config $poshConfig | Invoke-Expression
}

# ------------------------------------------------------------
# PSReadLine Bootstrap
# ------------------------------------------------------------

$MinPSReadLine = [Version]'2.3.6'

$InstalledPSReadLine = Get-Module PSReadLine -ListAvailable |
  Sort-Object Version -Descending |
  Select-Object -First 1

if (-not $InstalledPSReadLine -or $InstalledPSReadLine.Version -lt $MinPSReadLine)
{
  Install-Module PSReadLine -Repository PSGallery -Scope CurrentUser -Force -AllowClobber -ErrorAction SilentlyContinue

  Write-Host ""
  Write-Warning "Restart PowerShell to apply PSReadLine updates."
  Write-Host ""

  exit 0
}

# ------------------------------------------------------------
# PSReadLine Configuration
# ------------------------------------------------------------

if (Get-Module -ListAvailable PSReadLine)
{
  Import-Module PSReadLine

  Set-PSReadLineOption -PredictionSource History
  Set-PSReadLineOption -HistorySearchCursorMovesToEnd
  # Set-PSReadLineOption -PredictionViewStyle ListView

  Set-PSReadLineKeyHandler -Key UpArrow   -Function HistorySearchBackward
  Set-PSReadLineKeyHandler -Key DownArrow -Function HistorySearchForward
}

# ------------------------------------------------------------
# PSFzf Bootstrap + Config
# ------------------------------------------------------------

if (-not (Get-Module -ListAvailable PSFzf))
{
  Install-Module PSFzf -Repository PSGallery -Scope CurrentUser -Force -ErrorAction SilentlyContinue
}

if (Get-Module -ListAvailable PSFzf)
{
  Import-Module PSFzf

  Set-PsFzfOption -PSReadlineChordReverseHistory 'Ctrl+r'
  Set-PsFzfOption -PSReadlineChordProvider 'Ctrl+t'
}

# ------------------------------------------------------------
# Terminal Icons
# ------------------------------------------------------------

if (-not (Get-Module -ListAvailable Terminal-Icons))
{
  Install-Module Terminal-Icons -Repository PSGallery -Scope CurrentUser -Force -ErrorAction SilentlyContinue
}

if (Get-Module -ListAvailable Terminal-Icons)
{
  try {
    Import-Module Terminal-Icons -ErrorAction Stop
  } catch {
    # Wipe the corrupted cache if Import-CliXml throws an exception
    Remove-Item -Path "$env:APPDATA\powershell\Community\Terminal-Icons" -Recurse -Force -ErrorAction SilentlyContinue
    # Retry loading the module cleanly
    Import-Module Terminal-Icons -ErrorAction SilentlyContinue
  }
}

# Environment Variables
# LazyGit config (multiple files via comma, same as Zsh)
$env:LG_CONFIG_FILE = "$env:XDG_CONFIG_HOME/lazygit/config.yml,$env:XDG_CONFIG_HOME/lazygit/themes/mocha/blue.yml"

# Bat CLI Config
$env:BAT_CONFIG_PATH = "$env:XDG_CONFIG_HOME/bat/config"

# Custom PATH
# UserProifle Local Path (uv)
$env:Path = "$env:USERPROFILE/.local/bin;$env:Path"

# LazyVim Mason Path
$env:Path = "$env:LOCALAPPDATA/lazyvim-data/mason/bin;$env:Path"

# Rust Cargo Path
$env:Path = "$env:USERPROFILE/.cargo/bin;$env:Path"

{{ if eq .chezmoi.os "windows" }}
# Komorebi config directory (archived; not launched by default)
$env:KOMOREBI_CONFIG_HOME = "$env:XDG_CONFIG_HOME/komorebi"

# Hooks and Activation
# mise Package Manager
if (Get-Command mise -ErrorAction SilentlyContinue) {
  (&mise activate pwsh) | Out-String | Invoke-Expression
}

# vfox Package Manager
if (Get-Command vfox -ErrorAction SilentlyContinue) {
  (&vfox activate pwsh) | Out-String | Invoke-Expression
}

{{ end }}

# ------------------------------------------------------------
# Zoxide (Directory Jumping)
# ------------------------------------------------------------

# Zoxide wraps the current prompt, but Oh My Posh redefines the prompt on
# every profile load and zoxide's own "hooked" flag then blocks re-wrapping.
# Clear the flag before initializing, and never wrap an already wrapped prompt.
if ((Get-Command zoxide -ErrorAction SilentlyContinue) -and
  (Get-Command prompt -ErrorAction SilentlyContinue).Definition -notlike '*__zoxide_hook*')
{
  Remove-Variable __zoxide_hooked -Scope Global -ErrorAction SilentlyContinue
  Invoke-Expression (& { zoxide init powershell --cmd cd | Out-String })

  # Keep `z`/`zi` alongside zoxide's `cd`/`cdi` aliases.
  Set-Alias -Name z -Value __zoxide_z -Option AllScope -Scope Global -Force
  Set-Alias -Name zi -Value __zoxide_zi -Option AllScope -Scope Global -Force
}

# ------------------------------------------------------------
# Utilities
# ------------------------------------------------------------

function which ($command)
{
  Get-Command -Name $command -ErrorAction SilentlyContinue |
    Select-Object -ExpandProperty Path -ErrorAction SilentlyContinue
}

function ls_alias {
    lsd $args
}
Set-Alias -Name ls -Value ls_alias -Option AllScope -Force

# Kickstart modular Neovim (isolated NVIM_APPNAME)
function kickvim {
    $previousAppName = $env:NVIM_APPNAME
    $env:NVIM_APPNAME = "kickmodvim"
    try {
        nvim @args
    } finally {
        $env:NVIM_APPNAME = $previousAppName
    }
}

# LazyVim Neovim (isolated NVIM_APPNAME)
function lazyvim {
    $previousAppName = $env:NVIM_APPNAME
    $env:NVIM_APPNAME = "lazyvim"
    try {
        nvim @args
    } finally {
        $env:NVIM_APPNAME = $previousAppName
    }
}

function psmux-load {
    param(
        [string]$Path = ".psmux.ps1"
    )

    # 1. Resolve path relative to where your shell is currently looking
    $TargetScript = Resolve-Path $Path -ErrorAction SilentlyContinue

    if ($TargetScript -and (Test-Path $TargetScript.Path)) {
        try {
            # 2. Unlock authorization variable in the current environment scope
            $env:PSMUX_LOAD_ACTIVE = "True"

            # 3. Dot-source the configuration file securely
            . $TargetScript.Path
        }
        finally {
            # 4. Instantly revoke authorization variable to clean up the environment
            Remove-Item env:PSMUX_LOAD_ACTIVE -ErrorAction SilentlyContinue
        }
    } else {
        Write-Error "Could not find a valid target script layout at: '$Path'"
    }
}

# Import the Chocolatey Profile that contains the necessary code to enable
# tab-completions to function for `choco`.
# Be aware that if you are missing these lines from your profile, tab completion
# for `choco` will not function.
# See https://ch0.co/tab-completion for details.
$ChocolateyProfile = "$env:ChocolateyInstall\helpers\chocolateyProfile.psm1"
if (Test-Path($ChocolateyProfile)) {
  Import-Module "$ChocolateyProfile"
}
